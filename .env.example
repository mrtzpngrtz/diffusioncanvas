# ── Required (hosted build) ───────────────────────────────────────────────────
SESSION_SECRET=
# Required when NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ── Model providers ───────────────────────────────────────────────────────────
# All optional, and all also settable in the admin panel at /admin.
# Leave one out and its models simply do not appear in the UI.
GOOGLE_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=

# ── OAuth (optional) ──────────────────────────────────────────────────────────
# Local email/password accounts work without any of these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Storage (optional) ────────────────────────────────────────────────────────
# Unset means file storage under ./data
REDIS_URL=

# ── Self-updating agent (optional) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
# Merge and deploy agent branches automatically instead of leaving them for review
AGENT_AUTO_MERGE=false
